<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Система управления библиотекой</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Библиотека</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/books">Книги</a>
                        </li>
                        <li class="nav-item" id="loansNav" style="display: none;">
                            <a class="nav-link" href="/user/loans">Мои займы</a>
                        </li>
                        <li class="nav-item" id="adminNav" style="display: none;">
                            <a class="nav-link" href="/admin/books/add">Добавить книгу</a>
                        </li>
                        <li class="nav-item" id="lookupsNav" style="display: none;">
                            <a class="nav-link" href="/admin/lookups">Справочники</a>
                        </li>
                        <li class="nav-item" id="reportsNav" style="display: none;">
                            <a class="nav-link" href="/admin/reports">Отчёты</a>
                        </li>
                        <li class="nav-item" id="historyNav" style="display: none;">
                            <a class="nav-link" href="/admin/history">Журнал изменений</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item" id="loginNav">
                            <a class="nav-link" href="/auth/login">Вход</a>
                        </li>
                        <li class="nav-item" id="registerNav">
                            <a class="nav-link" href="/auth/register">Регистрация</a>
                        </li>
                        <li class="nav-item" id="logoutNav" style="display: none;">
                            <button class="btn btn-link nav-link text-white" onclick="logout()">Выход</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

