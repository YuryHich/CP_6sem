@page
@model LibraryManagement.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Подтверждение email";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Подтверждение email</h2>
        <div id="messageContainer">
            <div id="loadingMessage" class="alert alert-info">
                <p>Проверка токена подтверждения...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const token = urlParams.get('token');
        const email = urlParams.get('email');

        if (!token || !email) {
            document.getElementById('messageContainer').innerHTML = `
                <div class="alert alert-danger">
                    <h4>Ошибка</h4>
                    <p>Неверная ссылка подтверждения. Пожалуйста, используйте ссылку из письма.</p>
                    <a href="/auth/login" class="btn btn-primary">Войти</a>
                </div>
            `;
        } else {
            // Отправляем запрос на подтверждение
            fetch('/api/auth/confirm-email', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ email, token })
            })
            .then(response => response.json())
            .then(data => {
                if (data.message) {
                    document.getElementById('messageContainer').innerHTML = `
                        <div class="alert alert-success">
                            <h4>Успешно!</h4>
                            <p>${data.message}</p>
                            <a href="/auth/login" class="btn btn-primary">Войти</a>
                        </div>
                    `;
                } else {
                    document.getElementById('messageContainer').innerHTML = `
                        <div class="alert alert-danger">
                            <h4>Ошибка</h4>
                            <p>${data.error || 'Не удалось подтвердить email. Токен может быть недействителен или просрочен.'}</p>
                            <a href="/auth/login" class="btn btn-primary">Войти</a>
                        </div>
                    `;
                }
            })
            .catch(error => {
                document.getElementById('messageContainer').innerHTML = `
                    <div class="alert alert-danger">
                        <h4>Ошибка</h4>
                        <p>Ошибка соединения с сервером.</p>
                        <a href="/auth/login" class="btn btn-primary">Войти</a>
                    </div>
                `;
            });
        }
    </script>
}

