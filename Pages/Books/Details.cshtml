@page "/books/{id:guid}"
@model LibraryManagement.Pages.Books.DetailsModel
@{
    ViewData["Title"] = "Детали книги";
}

<div id="bookDetails">
    <!-- Детали книги будут загружены здесь -->
</div>

<div class="mt-4" id="reviewsSection">
    <!-- Отзывы и рецензии будут загружены здесь -->
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Удалить книгу</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Вы уверены, что хотите удалить эту книгу? Это действие нельзя отменить.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Удалить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const bookId = '@RouteData.Values["id"]';
        const token = localStorage.getItem('token');
        const role = localStorage.getItem('role');
        const currentUserId = localStorage.getItem('userId');
        const currentUsername = localStorage.getItem('username');
        let selectedReviewId = null;
        let deleteModalInstance = null;

        async function loadBookDetails() {
            try {
                const response = await fetch(`/api/books/${bookId}`);
                if (!response.ok) {
                    document.getElementById('bookDetails').innerHTML = '<div class="alert alert-warning">Книга не найдена</div>';
                    return;
                }

                const book = await response.json();
                displayBookDetails(book);
            } catch (error) {
                console.error('Ошибка загрузки книги:', error);
                document.getElementById('bookDetails').innerHTML = '<div class="alert alert-danger">Не удалось загрузить книгу</div>';
            }
        }

        function renderReviews(reviews) {
            const container = document.getElementById('reviewsSection');
            const isAdmin = role === 'admin';
            const userId = currentUserId;

            const userAlreadyReviewed = !!(token && userId && reviews.some(r => r.userId === userId));

            const rowsHtml = reviews.length
                ? reviews.map(r => {
                    const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
                    const date = new Date(r.reviewDate).toLocaleString('ru-RU');
                    const safeComment = r.comment ? r.comment : '';
                    return `
                        <tr data-review-id="${r.reviewId}">
                            <td>${r.username}</td>
                            <td><span class="text-warning">${stars}</span> (${r.rating})</td>
                            <td>${safeComment}</td>
                            <td>${date}</td>
                        </tr>
                    `;
                }).join('')
                : `
                    <tr>
                        <td colspan="4" class="text-muted text-center">Отзывов пока нет</td>
                    </tr>
                `;

            const deleteButtonHtml = isAdmin
                ? `
                    <button type="button" id="deleteReviewBtn" class="btn btn-outline-danger btn-sm mt-2" style="display:none;">
                        Удалить выбранный отзыв
                    </button>
                `
                : '';

            const reviewFormHtml = token
                ? (userAlreadyReviewed
                    ? `<div class="alert alert-info mt-3">Вы уже оставляли отзыв</div>`
                    : `
                        <div class="card mt-3">
                            <div class="card-body">
                                <h6 class="card-title">Оставить отзыв</h6>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label for="reviewRating" class="form-label">Оценка (1–5)</label>
                                        <select id="reviewRating" class="form-select">
                                            <option value="5">5</option>
                                            <option value="4">4</option>
                                            <option value="3">3</option>
                                            <option value="2">2</option>
                                            <option value="1">1</option>
                                        </select>
                                    </div>
                                    <div class="col-md-9">
                                        <label for="reviewComment" class="form-label">Текст отзыва</label>
                                        <textarea id="reviewComment" class="form-control" rows="3" maxlength="2000"></textarea>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button type="button" id="submitReviewBtn" class="btn btn-primary btn-sm">
                                        Оставить отзыв
                                    </button>
                                </div>
                                <div id="reviewError" class="alert alert-danger d-none mt-2"></div>
                            </div>
                        </div>
                    `)
                : `<div class="alert alert-secondary mt-3">Чтобы оставить отзыв, необходимо <a href="/auth/login">войти</a> в систему.</div>`;

            container.innerHTML = `
                <div class="card">
                    <div class="card-header">
                        Отзывы и рецензии
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" id="reviewsTable">
                                <thead>
                                    <tr>
                                        <th>Пользователь</th>
                                        <th>Оценка</th>
                                        <th>Текст отзыва</th>
                                        <th>Дата</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${rowsHtml}
                                </tbody>
                            </table>
                        </div>
                        ${deleteButtonHtml}
                        ${reviewFormHtml}
                    </div>
                </div>
            `;

            // Обработка выбора отзыва для удаления (только admin)
            const tableRows = container.querySelectorAll('#reviewsTable tbody tr[data-review-id]');
            const deleteBtn = document.getElementById('deleteReviewBtn');
            selectedReviewId = null;
            if (isAdmin && deleteBtn) {
                tableRows.forEach(row => {
                    row.style.cursor = 'pointer';
                    row.addEventListener('click', () => {
                        tableRows.forEach(r => r.classList.remove('table-active'));
                        row.classList.add('table-active');
                        selectedReviewId = row.getAttribute('data-review-id');
                        deleteBtn.style.display = 'inline-block';
                    });
                });

                deleteBtn.addEventListener('click', async () => {
                    if (!selectedReviewId) {
                        alert('Выберите отзыв для удаления');
                        return;
                    }
                    if (!confirm('Вы действительно хотите удалить выбранный отзыв?')) {
                        return;
                    }
                    try {
                        const response = await fetch(`/api/reviews/${selectedReviewId}`, {
                            method: 'DELETE',
                            headers: {
                                'Authorization': `Bearer ${token}`
                            }
                        });
                        if (!response.ok) {
                            const error = await response.json().catch(() => null);
                            throw new Error(error?.error || 'Ошибка при удалении отзыва');
                        }
                        alert('Отзыв удалён');
                        await loadReviews();
                    } catch (e) {
                        alert(e.message || 'Не удалось удалить отзыв');
                    }
                });
            }

            const submitBtn = document.getElementById('submitReviewBtn');
            if (submitBtn) {
                submitBtn.addEventListener('click', submitReview);
            }
        }

        async function loadReviews() {
            const container = document.getElementById('reviewsSection');
            try {
                const response = await fetch(`/api/reviews/book/${bookId}`);
                if (!response.ok) {
                    container.innerHTML = '<div class="alert alert-danger">Не удалось загрузить отзывы</div>';
                    return;
                }
                const reviews = await response.json();
                renderReviews(reviews);
            } catch (error) {
                console.error('Ошибка загрузки отзывов:', error);
                container.innerHTML = '<div class="alert alert-danger">Не удалось загрузить отзывы</div>';
            }
        }

        async function submitReview() {
            const ratingSelect = document.getElementById('reviewRating');
            const commentInput = document.getElementById('reviewComment');
            const errorBox = document.getElementById('reviewError');

            if (!token) {
                alert('Для отправки отзыва необходимо войти в систему');
                window.location.href = '/auth/login';
                return;
            }

            const rating = parseInt(ratingSelect.value, 10);
            const comment = (commentInput.value || '').trim();

            errorBox.classList.add('d-none');
            errorBox.textContent = '';

            if (!Number.isFinite(rating) || rating < 1 || rating > 5) {
                errorBox.textContent = 'Оценка должна быть от 1 до 5';
                errorBox.classList.remove('d-none');
                return;
            }
            if (!comment) {
                errorBox.textContent = 'Введите текст отзыва';
                errorBox.classList.remove('d-none');
                return;
            }

            try {
                const response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        bookId: bookId,
                        rating: rating,
                        comment: comment
                    })
                });

                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    const message = error?.error || 'Ошибка при отправке отзыва';
                    errorBox.textContent = message;
                    errorBox.classList.remove('d-none');
                    return;
                }

                alert('Отзыв успешно сохранён');
                await loadReviews();
            } catch (e) {
                errorBox.textContent = e.message || 'Ошибка соединения';
                errorBox.classList.remove('d-none');
            }
        }

        function displayBookDetails(book) {
            const container = document.getElementById('bookDetails');
            const authorsList = (book.authorNames && book.authorNames.length) ? book.authorNames : [];
            const genresList = (book.genreNames && book.genreNames.length) ? book.genreNames : [];
            const authors = authorsList.length ? authorsList.join(', ') : 'Не указаны';
            const genres = genresList.length ? genresList.join(', ') : 'Не указаны';
            const isAvailable = book.availableCopies > 0;
            const canLoan = role === 'user' && !!token && isAvailable;

            const branchesSection = (book.branchAvailability && book.branchAvailability.length)
                ? `
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Филиал</th>
                                    <th>Адрес</th>
                                    <th>Доступно</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${book.branchAvailability.map(branch => `
                                    <tr>
                                        <td>${branch.branchName}</td>
                                        <td>${branch.address ? branch.address : ''} ${branch.city ? `(${branch.city})` : ''}</td>
                                        <td>${branch.availableCopies} / ${branch.totalCopies}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `
                : '<p class="text-muted mt-3">Информация о филиалах отсутствует</p>';

            container.innerHTML = `
                <div class="row gy-3">
                    <div class="col-md-4">
                        ${book.coverImagePath
                            ? `<img src="/images/${book.coverImagePath}" class="img-fluid rounded" alt="Обложка книги">`
                            : '<div class="border rounded p-3 text-center text-muted">Изображение отсутствует</div>'}
                    </div>
                    <div class="col-md-8">
                        <h2>${book.title}</h2>
                        <p class="mb-1"><strong>Авторы:</strong> ${authors}</p>
                        <p class="mb-1"><strong>Жанры:</strong> ${genres}</p>
                        <p class="mb-1"><strong>ISBN:</strong> ${book.isbn}</p>
                        <p class="mb-1"><strong>Год издания:</strong> ${book.publicationYear ?? 'Не указан'}</p>
                        <p class="mb-1"><strong>Описание:</strong> ${book.description ?? 'Нет описания'}</p>
                        <p class="mb-3"><strong>Доступно копий:</strong> ${book.availableCopies}</p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            ${canLoan ? `<button class="btn btn-success" onclick="loanBook(this)">Взять книгу</button>` : ''}
                            ${(!canLoan && isAvailable && role !== 'user') ? '<span class="text-muted">Взять книгу может только пользователь</span>' : ''}
                            ${!isAvailable ? '<span class="text-danger fw-semibold">Нет в наличии</span>' : ''}
                            ${role === 'admin'
                                ? `
                                    <a href="/admin/books/edit/${book.bookId}" class="btn btn-warning">Редактировать</a>
                                    <button class="btn btn-outline-danger" onclick="deleteBook()">Удалить</button>
                                `
                                : ''}
                        </div>

                        <h5>Наличие по филиалам</h5>
                        ${branchesSection}
                    </div>
                </div>
            `;
        }

        async function loanBook(button) {
            if (!token) {
                alert('Необходимо войти в систему');
                window.location.href = '/auth/login';
                return;
            }

            button.disabled = true;
            button.textContent = 'Обработка...';

            try {
                const response = await fetch(`/api/books/${bookId}/loan`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Ошибка при взятии книги');
                }

                alert('Книга успешно взята');
                await loadBookDetails();
            } catch (error) {
                alert(error.message);
            } finally {
                button.disabled = false;
                button.textContent = 'Взять книгу';
            }
        }

        function deleteBook() {
            if (role !== 'admin') {
                alert('Недостаточно прав для удаления книги');
                return;
            }

            const modalElement = document.getElementById('deleteModal');
            deleteModalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
            deleteModalInstance.show();

            document.getElementById('confirmDeleteBtn').onclick = confirmDelete;
        }

        async function confirmDelete() {
            try {
                const response = await fetch(`/api/books/${bookId}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Ошибка при удалении книги');
                }

                deleteModalInstance?.hide();
                alert('Книга удалена');
                window.location.href = '/books';
            } catch (error) {
                alert(error.message);
            }
        }

        loadBookDetails();
        loadReviews();
    </script>
}

