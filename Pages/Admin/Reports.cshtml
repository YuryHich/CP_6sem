@page
@model LibraryManagement.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Отчёты";
}

<h2>Генерация отчётов</h2>

<form id="reportForm">
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="fromDate" class="form-label">С даты</label>
            <input type="date" class="form-control" id="fromDate" required>
        </div>
        <div class="col-md-4">
            <label for="toDate" class="form-label">По дату</label>
            <input type="date" class="form-control" id="toDate" required>
        </div>
    </div>
    <div class="mb-3">
        <button type="button" class="btn btn-primary" onclick="generateReport('pdf')">Сгенерировать PDF</button>
        <button type="button" class="btn btn-success" onclick="generateReport('excel')">Сгенерировать Excel</button>
    </div>
</form>

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Отчёт о взятых книгах</h5>
        <p class="card-text">Генерация PDF отчёта со всеми займами (пользователь, книга, даты, статус).</p>
        <button type="button" class="btn btn-info" onclick="generateLoansReport()">
            <span id="loansReportBtnText">Генерация PDF отчёта о займах</span>
            <span id="loansReportBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
        </button>
        <div id="loansReportMessage" class="alert mt-3" style="display: none;"></div>
    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem('token');
        const role = localStorage.getItem('role');

        if (!token || role !== 'admin') {
            window.location.href = '/auth/login';
        }

        // Устанавливаем значения по умолчанию (последний месяц)
        const today = new Date();
        const lastMonth = new Date(today.getFullYear(), today.getMonth() - 1, today.getDate());
        document.getElementById('toDate').value = today.toISOString().split('T')[0];
        document.getElementById('fromDate').value = lastMonth.toISOString().split('T')[0];

        async function generateReport(format) {
            const fromDate = document.getElementById('fromDate').value;
            const toDate = document.getElementById('toDate').value;

            if (!fromDate || !toDate) {
                alert('Выберите даты');
                return;
            }

            try {
                const endpoint = format === 'pdf' ? 'pdf' : 'excel';
                const response = await fetch(`/api/reports/${endpoint}?fromDate=${fromDate}&toDate=${toDate}`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.ok) {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `report_${fromDate}_${toDate}.${format === 'pdf' ? 'pdf' : 'xlsx'}`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                } else {
                    alert('Ошибка при генерации отчёта');
                }
            } catch (error) {
                alert('Ошибка соединения');
            }
        }

        async function generateLoansReport() {
            const loansReportBtn = document.getElementById('loansReportBtnText');
            const loansReportBtnSpinner = document.getElementById('loansReportBtnSpinner');
            const loansReportMessage = document.getElementById('loansReportMessage');

            loansReportBtn.textContent = 'Генерация...';
            loansReportBtnSpinner.classList.remove('d-none');
            loansReportMessage.style.display = 'none';

            try {
                const response = await fetch('/api/reports/loans-pdf', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.ok) {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    
                    const contentDisposition = response.headers.get('Content-Disposition');
                    let fileName = 'loans_report.pdf';
                    if (contentDisposition) {
                        const fileNameMatch = contentDisposition.match(/filename="?(.+)"?/);
                        if (fileNameMatch) {
                            fileName = fileNameMatch[1];
                        }
                    }
                    
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);

                    loansReportMessage.className = 'alert alert-success mt-3';
                    loansReportMessage.textContent = 'PDF отчёт успешно сгенерирован и загружен.';
                    loansReportMessage.style.display = 'block';
                } else {
                    const error = await response.json();
                    loansReportMessage.className = 'alert alert-danger mt-3';
                    loansReportMessage.textContent = error.error || 'Ошибка при генерации отчёта';
                    loansReportMessage.style.display = 'block';
                }
            } catch (error) {
                loansReportMessage.className = 'alert alert-danger mt-3';
                loansReportMessage.textContent = 'Ошибка соединения';
                loansReportMessage.style.display = 'block';
            } finally {
                loansReportBtn.textContent = 'Генерация PDF отчёта о займах';
                loansReportBtnSpinner.classList.add('d-none');
            }
        }
    </script>
}

