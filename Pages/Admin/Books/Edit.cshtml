@page "{id}"
@model LibraryManagement.Pages.Admin.Books.EditModel
@{
    ViewData["Title"] = "Редактировать книгу";
}

<h2>Редактировать книгу</h2>

<div id="bookFormContainer">
    <!-- Форма будет загружена через JS -->
</div>

@section Scripts {
    <script>
        const bookId = '@RouteData.Values["id"]';
        const token = localStorage.getItem('token');
        const role = localStorage.getItem('role');
        if (!token || role !== 'admin') {
            window.location.href = '/auth/login';
        }

        const container = document.getElementById('bookFormContainer');
        let lookupsCache = null;

        async function fetchBook() {
            const response = await fetch(`/api/books/${bookId}`);
            if (!response.ok) {
                throw new Error('Книга не найдена');
            }
            return response.json();
        }

        async function loadLookups() {
            const [authors, genres, publishers, languages, series] = await Promise.all([
                fetch('/api/authors'),
                fetch('/api/genres'),
                fetch('/api/publishers'),
                fetch('/api/languages'),
                fetch('/api/series')
            ].map(async req => {
                const res = await req;
                if (!res.ok) throw new Error('Ошибка загрузки справочников');
                return res.json();
            }));

            return { authors, genres, publishers, languages, series };
        }

        function populateSelect(selectId, items, mapFn) {
            const select = document.getElementById(selectId);
            items.forEach(item => {
                const { value, label } = mapFn(item);
                const option = document.createElement('option');
                option.value = value;
                option.textContent = label;
                select.appendChild(option);
            });
        }

        function setMultiSelectValues(selectId, values) {
            const select = document.getElementById(selectId);
            values.forEach(value => {
                const option = select.querySelector(`option[value="${value}"]`);
                if (option) {
                    option.selected = true;
                }
            });
        }

        function displayForm(book) {
            container.innerHTML = `
                <form id="bookForm">
                    <div class="mb-3">
                        <label for="isbn" class="form-label">ISBN</label>
                        <input type="text" class="form-control" id="isbn" value="${book.isbn}" required maxlength="13">
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">Название</label>
                        <input type="text" class="form-control" id="title" value="${book.title}" required maxlength="200">
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Описание</label>
                        <textarea class="form-control" id="description" rows="3">${book.description || ''}</textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="publicationYear" class="form-label">Год издания</label>
                            <input type="number" class="form-control" id="publicationYear" value="${book.publicationYear || ''}" min="1" max="2100">
                        </div>
                        <div class="col-md-4">
                            <label for="publisher" class="form-label d-flex justify-content-between align-items-center">
                                <span>Издательство</span>
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="openAddModal('publisher')">+ Добавить</button>
                            </label>
                            <div class="d-flex gap-2">
                                <select class="form-select flex-grow-1" id="publisher">
                                    <option value="">Не выбрано</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="language" class="form-label d-flex justify-content-between align-items-center">
                                <span>Язык</span>
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="openAddModal('language')">+ Добавить</button>
                            </label>
                            <div class="d-flex gap-2">
                                <select class="form-select flex-grow-1" id="language">
                                    <option value="">Не выбран</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label for="series" class="form-label">Серия</label>
                            <div class="d-flex gap-2">
                                <select class="form-select flex-grow-1" id="series">
                                    <option value="">Не выбрана</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="copiesCount" class="form-label">Количество копий по умолчанию</label>
                            <input type="number" class="form-control" id="copiesCount" min="1" value="${book.copiesCount || 1}">
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label for="authors" class="form-label">Авторы</label>
                            <div class="d-flex gap-2">
                                <select class="form-select flex-grow-1" id="authors" multiple size="5"></select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="genres" class="form-label">Жанры</label>
                            <div class="d-flex gap-2">
                                <select class="form-select flex-grow-1" id="genres" multiple size="5"></select>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label for="addCopies" class="form-label">Добавить экземпляры в библиотеку:</label>
                            <input type="number" class="form-control" id="addCopies" min="1" max="50" value="1">
                            <div class="form-text">Минимум 1, максимум 50. Если не нужно добавлять новые экземпляры, оставьте 0 или очистите поле.</div>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="image" class="form-label">Обложка</label>
                        <input type="file" class="form-control" id="image" accept="image/jpeg,image/png">
                        ${book.coverImagePath ? `<p class="mt-2">Текущая обложка:<br><img src="/images/${book.coverImagePath}" alt="Обложка" style="max-height: 120px;"></p>` : ''}
                    </div>
                    <div id="errorMessage" class="alert alert-danger d-none"></div>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a href="/books/${bookId}" class="btn btn-secondary">Отмена</a>
                </form>
            `;

            populateSelect('authors', lookupsCache.authors, author => ({
                value: author.authorId,
                label: `${author.firstName} ${author.lastName}`.trim()
            }));
            populateSelect('genres', lookupsCache.genres, genre => ({
                value: genre.genreId,
                label: genre.genreName
            }));
            populateSelect('publisher', lookupsCache.publishers, publisher => ({
                value: publisher.publisherId,
                label: publisher.publisherName
            }));
            populateSelect('language', lookupsCache.languages, language => ({
                value: language.languageId,
                label: language.languageName
            }));
            populateSelect('series', lookupsCache.series, item => ({
                value: item.seriesId,
                label: item.seriesName
            }));

            setMultiSelectValues('authors', book.authorIds || []);
            setMultiSelectValues('genres', book.genreIds || []);
            document.getElementById('publisher').value = book.publisherId ?? '';
            document.getElementById('language').value = book.languageId ?? '';
            document.getElementById('series').value = book.seriesId ?? '';

            document.getElementById('bookForm').addEventListener('submit', event => submitForm(event, book.coverImagePath));
        }

        async function submitForm(event, currentCover) {
            event.preventDefault();
            const errorMessage = document.getElementById('errorMessage');
            errorMessage.classList.add('d-none');
            errorMessage.textContent = '';

            const isbn = document.getElementById('isbn').value;
            const title = document.getElementById('title').value;
            const description = document.getElementById('description').value;
            const publicationYear = document.getElementById('publicationYear').value;
            const authorIds = Array.from(document.getElementById('authors').selectedOptions).map(opt => opt.value);
            const genreIds = Array.from(document.getElementById('genres').selectedOptions).map(opt => opt.value);
            const publisherId = document.getElementById('publisher').value || null;
            const languageId = document.getElementById('language').value || null;
            const seriesId = document.getElementById('series').value || null;
            const copiesCountValue = parseInt(document.getElementById('copiesCount').value, 10);
            const copiesCount = Number.isFinite(copiesCountValue) && copiesCountValue > 0 ? copiesCountValue : 1;
            const addCopiesRaw = document.getElementById('addCopies').value;
            const addCopiesValue = addCopiesRaw ? parseInt(addCopiesRaw, 10) : 0;
            let addCopies = 0;
            if (Number.isFinite(addCopiesValue) && addCopiesValue > 0) {
                if (addCopiesValue > 50) {
                    errorMessage.textContent = 'Нельзя добавить более 50 экземпляров за один раз';
                    errorMessage.classList.remove('d-none');
                    return;
                }
                addCopies = addCopiesValue;
            }
            const imageFile = document.getElementById('image').files[0];

            const bookData = {
                isbn,
                title,
                description,
                publicationYear: publicationYear ? parseInt(publicationYear, 10) : null,
                authorIds,
                genreIds,
                publisherId,
                languageId,
                seriesId,
                copiesCount,
                addCopies,
                coverImagePath: currentCover
            };

            try {
                const response = await fetch(`/api/books/${bookId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(bookData)
                });

                let addedCopies = 0;
                if (!response.ok) {
                    const error = await response.json().catch(() => null);
                    throw new Error(error?.error || 'Ошибка при обновлении книги');
                } else {
                    const data = await response.json().catch(() => null);
                    if (data && typeof data.addedCopies === 'number') {
                        addedCopies = data.addedCopies;
                    }
                }

                if (imageFile) {
                    const formData = new FormData();
                    formData.append('file', imageFile);
                    await fetch(`/api/books/${bookId}/image`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${token}`
                        },
                        body: formData
                    });
                }

                if (addedCopies > 0) {
                    alert(`Книга успешно обновлена. Добавлено ${addedCopies} экземпляров.`);
                } else {
                    alert('Книга успешно обновлена');
                }
                window.location.href = `/books/${bookId}`;
            } catch (error) {
                errorMessage.textContent = error.message || 'Ошибка соединения';
                errorMessage.classList.remove('d-none');
            }
        }

        (async function init() {
            try {
                const [book, lookups] = await Promise.all([fetchBook(), loadLookups()]);
                lookupsCache = lookups;
                displayForm(book);
            } catch (error) {
                container.innerHTML = `<div class="alert alert-danger">${error.message}</div>`;
            }
        })();
    </script>
}

